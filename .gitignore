# Development workflow artifacts (GSD/superpowers)
.planning/
docs/superpowers/
.skills/
.ontoskills/
/ontostore/
node_modules/
.agents/
mcp/target/
.env
.env.*
!.env.example
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
docs/*
# ADRs are part of the design record and must be versioned
!docs/adr/

# ONNX test fixtures (large files)
mcp/tests/fixtures/

# Compiled ontology output (regenerate with: ontoskills compile)
ontoskills/
ontoskills/system/

# Benchmark logs
benchmark_results.log
.log

# DocBench: source documents and real annotations stay local
benchmark/docbench/private/
benchmark/docbench/runs/
benchmark/docbench/gold/claims.jsonl
benchmark/docbench/gold/questions.jsonl
# Generated by compile_claims.py: spans of the local corpus, rebuild locally
benchmark/docbench/gold/*.spans.jsonl
benchmark/docbench/gold/*.compiled.jsonl*

# Astro build cache
.astro/

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
*.log
