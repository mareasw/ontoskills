    doc:inContext ex:ctx_dsid_03af1e44970d4d6db6e85bc2c5fce8de ;
    doc:hasStatement "Emergency maintenance is with 48h notice and rolling failover." ;
    doc:hasModality doc:Recommendation ;
    doc:hasDeadline "48h" ;
    doc:hasEvidence ex:ev_dsid_03af1e44970d4d6db6e85bc2c5fce8de-0016_0 ;
