ex:claim_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0025 a doc:Claim ;
    doc:inContext ex:ctx_dsid_020bac2fb6ac4de28d5afb63e39a0c10 ;
    doc:hasStatement "If unknown, ICs classify as CAPACITY and tag Routing as contributing system." ;
    doc:hasModality doc:ProcedureStep ;
    doc:hasActor "ICs" ;
    doc:hasCondition "unknown" ;
    doc:hasEvidence ex:ev_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0025_0, ex:ev_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0025_1 ;
    prov:wasDerivedFrom ex:doc_dsid_020bac2fb6ac4de28d5afb63e39a0c10 .

ex:ev_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0025_0 a doc:Evidence ;
    doc:hasQuote "To address Mina's first-30-minutes concern: - Paging/escalation rules: CAPACITY incidents should page Fleet as primary AND also notify Routing immediately when fallback/admission control is involved. - Classification rule for ICs (write this into the decision tree): 1) If headroom is constrained (pool saturation, provisioning backlog, regional exhaustion) OR fallback_reason=capacity is dominant -> classify as CAPACITY.* (primary Fleet). 2) If headroom exists but router is falling back / shedding due to misconfig, bad rollout, policy bug, or incorrect health signals -> classify as ROUTING/FALLBACK.* (primary Routing)." ;
    doc:evidenceRole doc:supportsRole ;
    doc:hasLocator ex:loc_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0025_0 ;
    prov:wasDerivedFrom ex:doc_dsid_020bac2fb6ac4de28d5afb63e39a0c10 .
