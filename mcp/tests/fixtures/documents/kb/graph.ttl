ex:claim_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0023 a doc:Claim ;
    doc:inContext ex:ctx_dsid_020bac2fb6ac4de28d5afb63e39a0c10 ;
    doc:hasStatement "Fleet owns CAPACITY if the constraint is headroom (saturation/backlog/exhaustion)." ;
    doc:hasModality doc:Definition ;
    doc:hasActor "Fleet" ;
    doc:hasCondition "constraint is headroom (saturation/backlog/exhaustion)" ;
    doc:hasEvidence ex:ev_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0023_0 ;
    prov:wasDerivedFrom ex:doc_dsid_020bac2fb6ac4de28d5afb63e39a0c10 .

ex:ev_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0023_0 a doc:Evidence ;
    doc:hasQuote "IC decision rule (one-liner for the bot + policy page): - \"If the constraint is headroom (saturation/backlog/exhaustion) -> CAPACITY (Fleet owns). If headroom exists but fallbacks/shedding are incorrect -> ROUTING/FALLBACK (Routing owns). If unknown -> CAPACITY + tag Routing as contributing system, revisit within 30 minutes.\"" ;
    doc:evidenceRole doc:supportsRole ;
    doc:hasLocator ex:loc_dsid_020bac2fb6ac4de28d5afb63e39a0c10-0023_0 ;
    prov:wasDerivedFrom ex:doc_dsid_020bac2fb6ac4de28d5afb63e39a0c10 .
