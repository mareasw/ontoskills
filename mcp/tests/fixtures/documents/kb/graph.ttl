ex:claim_dsid_03af1e44970d4d6db6e85bc2c5fce8de-0028 a doc:Claim ;
    doc:inContext ex:ctx_dsid_03af1e44970d4d6db6e85bc2c5fce8de ;
    doc:hasStatement "Customer requires SOC2 Type II report." ;
    doc:hasModality doc:Obligation ;
    doc:hasActor "Customer" ;
    doc:hasEvidence ex:ev_dsid_03af1e44970d4d6db6e85bc2c5fce8de-0028_0, ex:ev_dsid_03af1e44970d4d6db6e85bc2c5fce8de-0028_1 ;
