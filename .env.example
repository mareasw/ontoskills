# OntoCore compiler configuration
# Any OpenAI-compatible endpoint: OpenAI, Cascade, a gateway, ...
OPENAI_BASE_URL=https://your-gateway.example/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=your-model-id

# Model used by the LLM-as-judge security review (defaults to OPENAI_MODEL)
SECURITY_MODEL=your-model-id

# Optional OntoSkills paths
# ONTOSKILLS_SKILLS_DIR=/absolute/path/to/skills
# ONTOSKILLS_OUTPUT_DIR=/absolute/path/to/ontoskills
# ONTOSKILLS_BASE_URI=http://ontoskills.sh/ontology#
